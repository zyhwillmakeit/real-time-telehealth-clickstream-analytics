# Copy to .env and supply values through local or managed secret storage.
# Never commit real credentials.

KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC=telehealth-clickstream
KAFKA_API_KEY=
KAFKA_API_SECRET=
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
SCHEMA_REGISTRY_URL=
SCHEMA_REGISTRY_API_KEY=
SCHEMA_REGISTRY_API_SECRET=

POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=telehealth
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require

DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=telehealth_dev
DATABRICKS_SCHEMA=smoke_test

AWS_REGION=us-east-1
S3_BUCKET=
# Optional for an S3-compatible local development service.
S3_ENDPOINT_URL=
